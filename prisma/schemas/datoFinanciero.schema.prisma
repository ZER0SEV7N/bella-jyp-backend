model dato_financiero {
  id                    String                     @id @db.Uuid
  empleado_id           String                     @unique @db.Uuid
  id_regimen            String                     @db.Uuid
  id_tipo_afp           String?                    @db.Uuid
  sueldo_basico         Decimal                    @default(0) @db.Decimal(12, 4)
  cuspp                 String?                    @db.VarChar(20)
  tipo_comision         String?                    @db.VarChar(50)

  //Cuenta de Pago de Sueldo
  id_banco_sueldo       String?                    @db.Uuid
  tipo_cuenta_sueldo    tipo_cuenta_bancaria_enum  @default(SUELDO)
  nro_cuenta_sueldo     String?                    @db.VarChar(30)
  cci_sueldo            String?                    @db.VarChar(30)

  //Cuenta de Depósito de CTS (Mayo y Noviembre)
  id_banco_cts          String?                    @db.Uuid
  tipo_cuenta_cts       tipo_cuenta_bancaria_enum  @default(AHORROS)
  nro_cuenta_cts        String?                    @db.VarChar(30)
  cci_cts               String?                    @db.VarChar(30)

  //Régimen de Aseguramiento de Salud (EsSalud vs EPS)
  regimen_salud         regimen_salud_enum         @default(ESSALUD_REGULAR)
  eps_nombre            String?                    @db.VarChar(100)
  eps_plan              String?                    @db.VarChar(100)
  eps_costo_adicional   Decimal                    @default(0.0000) @db.Decimal(10, 4)

  //Auditoria
  deleted_at            DateTime?                  @db.Timestamptz(6)
  created_at            DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)

  //Relaciones
  banco_sueldo          bancos?                    @relation("BancoSueldo", fields: [id_banco_sueldo], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_df_banco_sueldo")
  banco_cts             bancos?                    @relation("BancoCTS", fields: [id_banco_cts], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_df_banco_cts")
  empleados             empleados                  @relation(fields: [empleado_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dato_financiero_empleado")
  regimen_pension       regimen_pension            @relation(fields: [id_regimen], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dato_financiero_regimen")
  tipo_afp              tipo_afp?                  @relation(fields: [id_tipo_afp], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dato_financiero_tipo_afp")

  @@index([empleado_id], map: "idx_dato_fin_empleado")
  @@map("dato_financiero")
}