{
  "name": "bella-planillas-backend",
  "version": "0.0.1",
  "description": "",
  "author": "ME ZER0SEV7N And My Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "npm test -- --coverage --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:revision": "npm run build && npm run test:unit && npm run test:n8n && npm run check:complejidad",
    "actualizar:contratos": "node scripts/actualizar-contratos.cjs",
    "test:integracion:docker": "npm run build && node --test --test-concurrency=1 test/integracion/*.test.cjs",
    "check:complejidad": "node scripts/verificar-complejidad.cjs",
    "test:unit": "npm test -- --runInBand --coverage=false",
    "test:common": "npm test -- --runInBand --coverage=false --testPathPatterns=test/common",
    "test:asistencia": "npm test -- --runInBand --coverage=false --testPathPatterns=test/modules/asistencia",
    "test:payroll": "npm test -- --runInBand --coverage=false --testPathPatterns=test/modules/payroll",
    "test:integraciones": "npm test -- --runInBand --coverage=false --testPathPatterns=test/modules/integraciones",
    "test:n8n": "npm run build && node --test test/n8n/*.test.cjs",
    "db:crear": "node scripts/aplicar-sql.cjs crear",
    "db:instalar-objetos": "node scripts/aplicar-sql.cjs objetos",
    "db:demo": "node scripts/aplicar-sql.cjs demo",
    "db:seed": "prisma db seed",
    "demo:archivos": "npm run build && node scripts/generar-ejemplos-locales.cjs",
    "verificar:postman": "node scripts/verificar-postman.cjs",
    "verificar:pruebas-originales": "node scripts/auditar-pruebas-originales.cjs",
    "docs:exportar": "npm run build && node scripts/extraer-openapi.cjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "@jyp/shared-contracts": "git+https://github.com/ZER0SEV7N/bella-jyp-shared-contracts.git",
    "@nest-lab/fastify-multer": "^1.3.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.44.0",
    "axios": "^1.20.0",
    "bullmq": "^5.81.5",
    "csv-parse": "^7.0.3",
    "csv-parser": "^3.2.1",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^6.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfmake": "^0.3.13",
    "pg": "^8.23.1",
    "piscina": "^5.3.2",
    "pnpm": "^11.28.8",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "unzipper": "^0.12.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@prisma/config": "^7.10.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
