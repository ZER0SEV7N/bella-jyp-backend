
# URL directa al puerto 5432 (Solo usada por pnpm exec prisma db pull)
DIRECT_URL=

# URL de la aplicación
DATABASE_URL=

# Modo de ejecución de la aplicación (development, production, test)
NODE_ENV=development
PORT=3000

#KEY del api del DNI
RENIEC_API_KEY=

#URL del api del DNI
RENIEC_API_URL=

#Llave para firmar la cookie de sesión
COOKIE_SECRET=

# LLave para firmar el Access Token (JWT)
JWT_ACCESS_SECRET=

# LLave para firmar el Refresh Token (JWT)
JWT_REFRESH_SECRET=

# LLave maestra para cifrar y descifrar datos sensibles (AES-256)
FINANCIAL_DATA_ENCRYPTION_KEY=

# Redis conserva catálogos y trabajos de cálculo; el cálculo financiero no utiliza caché de resultados.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Identidad temporal de la única empresa del MVP; se captura al congelar cada planilla.
EMPRESA_NOMBRE=
EMPRESA_RUC=
EMPRESA_DIRECCION=
